{
  "expo": {
    "name": "Drive Starter",
    "slug": "drive-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anupmasud.drivestarter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anupmasud.drivestarter"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Drive Starter",
      "shortName": "Drive Starter",
      "themeColor": "#FBF7F0",
      "backgroundColor": "#FBF7F0",
      "display": "standalone",
      "description": "Your data, in a folder of your own Google Drive."
    },
    "plugins": [
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.432206356046-0ujmkctdc5rb3hobfp0chjvt5kgt4849"
        }
      ]
    ],
    "scheme": "drivestarter",
    "backgroundColor": "#FBF7F0"
  }
}